{
  "name": "evidra",
  "version": "0.1.0",
  "private": true,
  "description": "A research-focused autonomous experimentation workbench.",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "modal_app.py",
    "modal_controller.py"
  ],
  "bin": {
    "evidra": "./dist/cli.js",
    "workbench": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "prepack": "npm run build",
    "test": "npm run build && node --test tests/core-smoke.mjs",
    "start": "node dist/cli.js",
    "check": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "^0.85.1",
    "@earendil-works/pi-ai": "^0.85.1",
    "@earendil-works/pi-tui": "^0.85.1",
    "@openai/codex-sdk": "^0.153.4",
    "better-sqlite3": "^11.8.1",
    "commander": "^13.1.0",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "react": "^18.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
