  },
  "evaluator": {
    "command": [
      "uv",
      "run",
      "whest",
      "run",
      "--estimator",
      "estimator.py",
      "--dataset",
      "hf://aicrowd/arc-whestbench-public-2026@v2-phase2",
      "--split",
      "mini",
      "--runner",
      "subprocess"
    ],
    "estimatorPath": "estimator.py"
  },
  "baselineCommand": ["uv", "run", "whest", "run", "--estimator", "examples/02_mean_propagation.py", "--dataset", "hf://aicrowd/arc-whestbench-public-2026@v2-phase2", "--split", "mini", "--runner", "subprocess"],
  "experimentCommand": ["uv", "run", "whest", "run", "--estimator", "estimator.py", "--dataset", "hf://aicrowd/arc-whestbench-public-2026@v2-phase2", "--split", "mini", "--runner", "subprocess"],
  "execution": {
    "reducedValidationCommand": [
      "uv", "run", "whest", "run",
      "--estimator", "estimator.py",
      "--dataset", "hf://aicrowd/arc-whestbench-public-2026@v2-phase2",
      "--split", "mini",
      "--runner", "local",
      "--n-mlps", "1",
      "--streaming",
      "--format", "json"
    ],
    "reducedPromotion": {
      "enabled": true,
      "minimumDelta": 0,
      "tolerance": 0
    }
  },
  "researchSources": [
    "https://www.aicrowd.com/challenges/arc-white-box-estimation-challenge-2026",
    "https://www.aicrowd.com/challenges/arc-white-box-estimation-challenge-2026/discussion",
    "https://www.aicrowd.com/challenges/arc-white-box-estimation-challenge-2026/leaderboards",
    "https://github.com/AIcrowd/whest-starterkit",
    "https://github.com/AIcrowd/whestbench"
  ],
  "evaluatorTimeoutMinutes": 60,
  "submission": {
    "platform": "command",
    "source": "workspace",
    "workingDirectory": "competitions/whestbench/starterkit",
    "submitCommand": ["uv", "run", "whest", "submit", "--estimator", "estimator.py", "--watch"]
